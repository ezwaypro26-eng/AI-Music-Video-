generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Character {
  id           String    @id @default(cuid())
  name         String
  visualPrompt String
  refImagePath String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  projects     Project[]
}

model Project {
  id             String     @id @default(cuid())
  title          String
  concept        String     @default("")
  aspectRatio    String     @default("16:9")
  rawLyrics      String     @default("")
  lyricsJson     String     @default("[]")
  audioPath      String?
  vocalStemPath  String?
  characterId    String?
  character      Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)
  finalVideoPath String?
  status         String     @default("draft")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  scenes         Scene[]
}

model Scene {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  orderIndex   Int
  startSec     Float    @default(0)
  endSec       Float    @default(4)
  lyricSegment String   @default("")
  shotType     String   @default("Medium Close-Up")
  imagePrompt  String   @default("")
  motionPrompt String   @default("")
  imagePath    String?
  videoPath    String?
  status       String   @default("pending")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

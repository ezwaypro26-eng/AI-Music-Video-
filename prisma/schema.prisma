generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["nocturne"]
}

model Character {
  id           String    @id @default(cuid())
  name         String
  visualPrompt String
  refImagePath String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  projects     Project[]
  castEntries  ProjectCast[]

  @@schema("nocturne")
}

model Project {
  id             String     @id @default(cuid())
  title          String
  concept        String     @default("")
  aspectRatio    String     @default("16:9")
  videoType      String     @default("narrative")
  rawLyrics      String     @default("")
  lyricsJson     String     @default("[]")
  audioPath      String?
  vocalStemPath  String?
  characterId    String?
  character      Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)
  finalVideoPath String?
  status         String     @default("draft")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  scenes         Scene[]
  castMembers    ProjectCast[]

  @@schema("nocturne")
}

model Scene {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  orderIndex   Int
  startSec     Float    @default(0)
  endSec       Float    @default(4)
  lyricSegment String   @default("")
  shotType     String   @default("Medium Close-Up")
  imagePrompt  String   @default("")
  motionPrompt String   @default("")
  castArtistIds String   @default("[]")
  imagePath    String?
  videoPath    String?
  status       String   @default("pending")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@schema("nocturne")
}

model ProjectCast {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  artistId        String
  artist          Character @relation(fields: [artistId], references: [id], onDelete: Cascade)
  role            String   @default("Lead Vocalist")
  appearanceNotes String?
  sortOrder       Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([projectId, artistId])
  @@unique([projectId, sortOrder])
  @@index([artistId])

  @@schema("nocturne")
}

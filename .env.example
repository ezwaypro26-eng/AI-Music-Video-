# GEMINI_API_KEY: Optional for AI lyric/storyboard enhancement.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# FAL_KEY: Still used for Whisper and Sync Lipsync. FLUX image generation and Demucs vocal separation run on Modal.
FAL_KEY="MY_FAL_API_KEY"

# OPENAI_API_KEY: Required for GPT-4o AI Director structured storyboard generation.
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Modal LTX-2.5 video service (set after the Modal app is deployed).
MODAL_LTX_URL="https://YOUR-MODAL-WEB-URL"
MODAL_LTX_API_TOKEN="YOUR_SHARED_LTX_API_TOKEN"

# Modal FLUX image service (set after the Modal FLUX app is deployed).
MODAL_FLUX_URL="https://YOUR-MODAL-FLUX-WEB-URL"
MODAL_FLUX_API_TOKEN="YOUR_SHARED_MODAL_APP_API_TOKEN"

# Modal Demucs vocal separation service (set after the Modal app is deployed).
MODAL_DEMUCS_URL="https://YOUR-MODAL-DEMUCS-WEB-URL"
MODAL_DEMUCS_API_TOKEN="YOUR_SHARED_MODAL_APP_API_TOKEN"

# OPENAI_API_KEY: Required for GPT-4o AI Director structured storyboard generation.
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Modal LTX-2.5 B-roll video generation.
# MODAL_LTX_URL is the deployed Modal /generate endpoint URL.
MODAL_LTX_URL=""
# Must match LTX_API_TOKEN stored in the Modal Secret.
MODAL_LTX_TOKEN=""

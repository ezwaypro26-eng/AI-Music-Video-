# GEMINI_API_KEY: Optional for AI lyric/storyboard enhancement.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# FAL_KEY: Required for @fal-ai/client portrait, whisper, demucs, and flux-pro/kontext generation.
